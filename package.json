{
  "name": "waifu-verse",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "cross-env NODE_ENV=production node server.js",
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "debug": "cross-env DEBUG=waifu-verse:server npm run dev",
    "dev:css": "tailwindcss -i src/app/styles/tailwind.input.css -o ./public/stylesheets/tailwind.css --watch",
    "build:css": "tailwindcss -i src/app/styles/tailwind.input.css -o ./public/stylesheets/tailwind.css --minify",
    "debug:full": "concurrently -n \"server,tailwind\" -c \"green,cyan\" \"npm run debug\" \"npm run dev:css\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "argon2": "^0.44.0",
    "cookie-parser": "~1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "debug": "~4.4.3",
    "dotenv-flow": "^4.1.0",
    "ejs": "3.1.10",
    "express": "5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "flowbite": "^3.1.2",
    "http-errors": "~2.0.0",
    "jsonwebtoken": "^9.0.2",
    "method-override": "^3.0.0",
    "mongoose": "^8.18.1",
    "morgan": "~1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "nodemon": "^3.1.10",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "redis": "^5.8.2",
    "sharp": "^0.34.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.3"
  }
}
