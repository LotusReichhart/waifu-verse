<div>
    <label for="<%= inputId %>" class="block mb-1 font-medium text-sm md:text-base">
        <%= label %> *
    </label>
    <input type="text" id="<%= inputId %>" name="<%= inputId %>" required
           value="<%= value || '' %>"
           class="w-full p-2 background-color-alt border-color rounded focus:outline-none focus:ring-1
                        focus:ring-gray-300 text-sm md:text-base">
    <% if(errorMessage){ %>
        <p class="text-error italic text-sm mt-2"><%= errorMessage %></p>
    <% } %>
</div>