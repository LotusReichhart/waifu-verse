<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="index, follow">
    <meta name="keywords" content="waifu, anime, character, AI, verse, interaction">
    <meta name="author" content="Lotus Reichhart - aka DNA">

    <title><%= loginJson.title %></title>
    <meta name="description" content="<%= loginJson.description %>">

    <meta property="og:title" content="<%= loginJson.title %>">
    <meta property="og:description" content="<%= loginJson.description %>">
    <meta property="og:image" content="/favicon.ico">
    <meta property="og:url" content="<%= canonicalUrl %>">
    <meta property="og:type" content="website">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= loginJson.title %>">
    <meta name="twitter:description" content="<%= loginJson.description %>">
    <meta name="twitter:image" content="/favicon.ico">

    <link rel="canonical" href="<%= canonicalUrl %>">

    <link rel="stylesheet" href="/stylesheets/tailwind.css">
    <link rel="stylesheet" href="/stylesheets/main.css">
    <link rel="icon" type="image/x-icon" href="/favicon.ico"/>

    <script src="/javascript/common/client-preferences.js"></script>

</head>
<body class="background-color">

<main class="min-h-screen flex items-center justify-center text-color">
    <div class="w-full max-w-md p-2 space-y-6">
        <h1 class="self-center text-3xl text-center text-primary font-bold whitespace-nowrap">WaifuVerse</h1>
        <div class="space-y-6">
            <div class="space-y-4">
                <h2 class="text-xl font-bold"><%= commonJson.label.login %></h2>

                <form action="/<%= lang %>/auth/login" method="POST" class="space-y-6">
                    <div class="space-y-3">
                        <%- include('../partials/field-input', {
                        label: `${commonJson.label.email} / ${commonJson.label.username}`,
                        inputId: 'input',
                        value: formData.input,
                        errorMessage: errorFields.input
                        }) %>

                        <%- include('../partials/password-input', {
                        label: commonJson.label.password,
                        inputId: 'password',
                        buttonId: 'togglePassword',
                        errorId: null,
                        errorMessage: errorFields.password
                        }) %>

                        <%- include('../../../partials/global-error-message',{
                        id: 'errorGlobal',
                        content: errorFields.global
                        }) %>
                    </div>

                    <div class="space-y-3">
                        <button type="submit"
                                class="w-full py-2 font-semibold button-disabled rounded"
                                disabled>
                            <%= commonJson.label.login.toUpperCase() %>
                        </button>
                        <div class="flex justify-end">
                            <a href="/auth/forgot-password" class="text-blue-600 hover:underline">
                                <%= commonJson.label.forgotPassword %>?
                            </a>
                        </div>
                    </div>
                </form>
            </div>

            <div class="space-y-6">
                <div class="mt-6 text-center text-sm md:text-base text-gray-600 dark:text-gray-300">
                    <%= loginJson.main.label.doNotHaveAccount %>
                    <a href="/auth/register" class="text-blue-600 hover:underline">
                        <%= loginJson.main.label.registerNow %>
                    </a>
                </div>

                <div class="relative my-5">
                    <div class="absolute inset-0 flex items-center px-4">
                        <div class="w-full border-t border-gray-200 dark:border-gray-600"></div>
                    </div>
                    <div class="relative flex justify-center text-sm">
                        <span class="background-color px-6"> <%= commonJson.label.or %></span>
                    </div>
                </div>

                <a href="/auth/google"
                   class="w-full flex items-center justify-center gap-2 p-2 bg-white rounded hover:bg-gray-100
                transition text-sm text-gray-600 md:text-base font-medium border-color">
                    <img src="/icons/google-icon.png" alt="Google" class="w-5 h-5">
                    <%= loginJson.main.label.loginWithGoogle %>
                </a>
            </div>
        </div>

        <div class="flex justify-center items-center space-x-4">
            <a href="/<%= lang %>/terms-of-use"
               target="_blank" rel="noopener noreferrer"
               class="text-sm font-normal hover:underline">
                <%= commonJson.label.termsOfUse %>
            </a>
            <span>
                |
            </span>
            <a href="/<%= lang %>/privacy-policy"
               target="_blank" rel="noopener noreferrer"
               class="text-sm font-normal hover:underline">
                <%= commonJson.label.privacyPolicy %>
            </a>
        </div>
    </div>
</main>

<script src="/javascript/common/flowbite.js"></script>
<script type="module" src="/javascript/auth/login.js"></script>

</body>
</html>
