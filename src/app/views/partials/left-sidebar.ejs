<aside id="left-sidebar"
       class="z-[120] md:z-[60] w-64 fixed top-0 left-0 h-full background-color-alt text-color shadow-lg
              transition-transform duration-300 ease-in-out <%= ls === "true" ? 'left-sidebar-shown' : 'left-sidebar-hidden' %> hidden md:block">

    <div class="flex items-center justify-between text-primary py-4 px-2">
        <%- include('app-logo',{isHomePage:false}) %>

        <button id="left-sidebar-close"
                class="primary-hover rounded text-xl transition">
            <svg class="w-7 h-7"
                 aria-hidden="true"
                 xmlns="http://www.w3.org/2000/svg"
                 width="24"
                 height="24"
                 fill="none"
                 viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M6 18 17.94 6M18 18 6.06 6"/>
            </svg>
        </button>
    </div>

    <nav class="px-2 mt-1 text-sm space-y-3">
        <a href="/"
           class="flex items-center p-1 rounded primary-hover text-xs uppercase font-semibold">
            <svg class="w-6 h-6 mr-1"
                 aria-hidden="true"
                 xmlns="http://www.w3.org/2000/svg"
                 width="24"
                 height="24"
                 fill="none"
                 viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="m4 12 8-8 8 8M6 10.5V19a1 1 0 0 0 1 1h3v-3a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3h3a1 1 0 0 0 1-1v-8.5"/>
            </svg>
            <%= leftSidebarJson.home %>
        </a>
        <div class="px-1">
            <p class="flex items-center text-xs uppercase font-semibold mb-1">
                <svg class="w-6 h-6 mr-1"
                     xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 15 15">
                    <path fill="currentColor" fill-rule="evenodd"
                          d="M7.5.875a3.625 3.625 0 0 0-1.006 7.109c-1.194.145-2.218.567-2.99 1.328c-.982.967-1.479 2.408-1.479 4.288a.475.475 0 1 0 .95 0c0-1.72.453-2.88 1.196-3.612c.744-.733 1.856-1.113 3.329-1.113s2.585.38 3.33 1.113c.742.733 1.195 1.892 1.195 3.612a.475.475 0 1 0 .95 0c0-1.88-.497-3.32-1.48-4.288c-.77-.76-1.795-1.183-2.989-1.328A3.627 3.627 0 0 0 7.5.875ZM4.825 4.5a2.675 2.675 0 1 1 5.35 0a2.675 2.675 0 0 1-5.35 0Z"
                          clip-rule="evenodd"/>
                </svg>
                <%= leftSidebarJson.characters.title %>
            </p>
            <a href="/characters"
               class="flex items-center py-1 px-2 rounded primary-hover "><%= leftSidebarJson.characters.links.list %>
            </a>
            <a href="/characters/new"
               class="flex items-center py-1 px-2 rounded primary-hover "><%= leftSidebarJson.characters.links.create %>
            </a>
        </div>
        <div class="px-1">
            <p class="flex items-center text-xs uppercase font-semibold mb-1">
                <svg class="w-6 h-6 mr-1"
                     xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 16 16">
                    <path fill="currentColor"
                          d="M3 3a2 2 0 1 1 4 0a2 2 0 0 1-4 0Zm2-1a1 1 0 1 0 0 2a1 1 0 0 0 0-2Zm4.779 2.584a2 2 0 1 1 2.442-3.168A2 2 0 0 1 9.78 4.584ZM11 2a1 1 0 1 0 0 2a1 1 0 0 0 0-2ZM2.5 6h2.67c-.11.313-.17.65-.17 1H2.5a.5.5 0 0 0-.5.5c0 .817.325 1.423.838 1.835c.236.19.519.343.839.455a2.5 2.5 0 0 0-.532.868a3.733 3.733 0 0 1-.933-.543C1.46 9.51 1 8.616 1 7.5A1.5 1.5 0 0 1 2.5 6Zm3.768 0a2 2 0 1 0 3.466 2a2 2 0 0 0-3.466-2Zm1.508.025A1.003 1.003 0 0 1 9 7a1 1 0 1 1-1.224-.975Zm5.386 3.31c-.236.19-.519.343-.839.455a2.5 2.5 0 0 1 .531.868c.34-.139.655-.32.934-.543C14.54 9.51 15 8.616 15 7.5A1.5 1.5 0 0 0 13.5 6h-2.67c.11.313.17.65.17 1h2.5a.5.5 0 0 1 .5.5c0 .817-.325 1.423-.838 1.835ZM10.5 10a1.5 1.5 0 0 1 1.5 1.5c0 1.116-.459 2.01-1.212 2.615C10.047 14.71 9.053 15 8 15c-1.053 0-2.047-.29-2.788-.885C4.46 13.51 4 12.616 4 11.5A1.496 1.496 0 0 1 5.5 10h5Zm0 1h-5a.5.5 0 0 0-.5.5c0 .817.325 1.423.838 1.835C6.364 13.757 7.12 14 8 14c.88 0 1.636-.243 2.162-.665c.513-.412.838-1.018.838-1.835a.5.5 0 0 0-.5-.5Z"/>
                </svg>
                <%= leftSidebarJson.community.title %>
            </p>
            <a href="/blogs"
               class="flex items-center py-1 px-2 rounded primary-hover "><%= leftSidebarJson.characters.links.blogs %></a>
        </div>
    </nav>
</aside>

<div id="left-sidebar-backdrop"
     class="fixed inset-0 bg-black/20 z-[110] hidden md:hidden transition-opacity duration-300 opacity-0"></div>

