<header class="app-header fixed w-full z-[50] transition-all duration-300">
    <div class="h-full flex flex-wrap items-center justify-between px-2 lg:px-6">
        <div class="text-primary">
            <div id="header-logo" class="space-x-1 flex <%= ls === 'true' ? 'md:hidden' : '' %>">
                <svg id="left-sidebar-toggle"
                     class="w-8 h-8 rounded md:block primary-hover"
                     aria-hidden="true"
                     xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     fill="none"
                     viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M5 7h14M5 12h14M5 17h10"/>
                </svg>
                <%- include('app-logo',{isHomePage:isHomePage}) %>
            </div>
        </div>

        <div class="flex space-x-3 items-center">
            <div id="search-backdrop" class="fixed inset-0 z-[40] hidden"></div>

            <div class="relative hidden md:flex z-[100] search-bar items-center
            background-color-alt primary-border text-primary rounded px-2">
                <svg class="w-6 h-6"
                     xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24">
                    <path fill="currentColor"
                          d="M10.77 18.3a7.53 7.53 0 1 1 7.53-7.53a7.53 7.53 0 0 1-7.53 7.53Zm0-13.55a6 6 0 1 0 6 6a6 6 0 0 0-6-6Z"/>
                    <path fill="currentColor"
                          d="M20 20.75a.74.74 0 0 1-.53-.22l-4.13-4.13a.75.75 0 0 1 1.06-1.06l4.13 4.13a.75.75 0 0 1 0 1.06a.74.74 0 0 1-.53.22Z"/>
                </svg>
                <input id="desktop-search-input" type="text"
                       class="flex-1 outline-none text-sm bg-transparent border-none placeholder:italic"
                       placeholder="<%= searchbarJson.label %>"
                       autocomplete="off">
                <button id="clear-desktop-search-input-btn" class="hidden">
                    <svg class="w-5 h-5"
                         aria-hidden="true"
                         xmlns="http://www.w3.org/2000/svg"
                         width="24"
                         height="24"
                         fill="none"
                         viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M6 18 17.94 6M18 18 6.06 6"/>
                    </svg>
                </button>
            </div>

            <div id="desktop-search-dropdown"
                 class="absolute p-3 search-bar top-full background-color-alt rounded shadow-lg z-[100] hidden w-full max-w-md">

                <%- include('app-shimmer', { shimmerId: 'desktop-search-shimmer' }) %>

                <ul id="desktop-search-results"></ul>

                <div id="desktop-search-empty" class="text-sm italic hidden"></div>
            </div>

            <button id="open-mobile-search-bar" class="p-1.5 primary-border text-primary rounded-lg md:hidden">
                <svg class="w-6 h-6"
                     xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24">
                    <path fill="currentColor"
                          d="M10.77 18.3a7.53 7.53 0 1 1 7.53-7.53a7.53 7.53 0 0 1-7.53 7.53Zm0-13.55a6 6 0 1 0 6 6a6 6 0 0 0-6-6Z"/>
                    <path fill="currentColor"
                          d="M20 20.75a.74.74 0 0 1-.53-.22l-4.13-4.13a.75.75 0 0 1 1.06-1.06l4.13 4.13a.75.75 0 0 1 0 1.06a.74.74 0 0 1-.53.22Z"/>
                </svg>
            </button>

            <% if (userInfo) { %>
                <button id="right-sidebar-toggle"
                        class="<%= userInfo.avatar ? 'w-9 h-9 rounded-full' : 'p-1.5 bg-transparent primary-border rounded-full' %>">
                    <% if (userInfo.avatar) { %>
                        <img class="object-cover rounded-full"
                             src="<%= userInfo.avatar %>"
                             alt="User Avatar">
                    <% } else { %>
                        <svg class="w-6 h-6"
                             xmlns="http://www.w3.org/2000/svg"
                             width="24"
                             height="24"
                             viewBox="0 0 15 15">
                            <path fill="currentColor" fill-rule="evenodd"
                                  d="M7.5.875a3.625 3.625 0 0 0-1.006 7.109c-1.194.145-2.218.567-2.99 1.328c-.982.967-1.479 2.408-1.479 4.288a.475.475 0 1 0 .95 0c0-1.72.453-2.88 1.196-3.612c.744-.733 1.856-1.113 3.329-1.113s2.585.38 3.33 1.113c.742.733 1.195 1.892 1.195 3.612a.475.475 0 1 0 .95 0c0-1.88-.497-3.32-1.48-4.288c-.77-.76-1.795-1.183-2.989-1.328A3.627 3.627 0 0 0 7.5.875ZM4.825 4.5a2.675 2.675 0 1 1 5.35 0a2.675 2.675 0 0 1-5.35 0Z"
                                  clip-rule="evenodd"/>
                        </svg>
                    <% } %>
                </button>
            <% } else { %>
                <button id="right-sidebar-toggle"
                        class="p-1.5 bg-transparent primary-border rounded-full">
                    <svg class="w-6 h-6"
                         xmlns="http://www.w3.org/2000/svg"
                         width="24"
                         height="24"
                         viewBox="0 0 15 15">
                        <path fill="currentColor" fill-rule="evenodd"
                              d="M7.5.875a3.625 3.625 0 0 0-1.006 7.109c-1.194.145-2.218.567-2.99 1.328c-.982.967-1.479 2.408-1.479 4.288a.475.475 0 1 0 .95 0c0-1.72.453-2.88 1.196-3.612c.744-.733 1.856-1.113 3.329-1.113s2.585.38 3.33 1.113c.742.733 1.195 1.892 1.195 3.612a.475.475 0 1 0 .95 0c0-1.88-.497-3.32-1.48-4.288c-.77-.76-1.795-1.183-2.989-1.328A3.627 3.627 0 0 0 7.5.875ZM4.825 4.5a2.675 2.675 0 1 1 5.35 0a2.675 2.675 0 0 1-5.35 0Z"
                              clip-rule="evenodd"/>
                    </svg>
                </button>
            <% } %>
        </div>

        <div id="mobile-search-bar"
             class="fixed inset-x-0 top-0 z-[100] background-color-alt text-primary px-2 py-4 items-center space-x-2 hidden">
            <div class="flex flex-1 items-center primary-border rounded px-1">
                <svg class="w-6 h-6"
                     xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     viewBox="0 0 24 24">
                    <path fill="currentColor"
                          d="M10.77 18.3a7.53 7.53 0 1 1 7.53-7.53a7.53 7.53 0 0 1-7.53 7.53Zm0-13.55a6 6 0 1 0 6 6a6 6 0 0 0-6-6Z"/>
                    <path fill="currentColor"
                          d="M20 20.75a.74.74 0 0 1-.53-.22l-4.13-4.13a.75.75 0 0 1 1.06-1.06l4.13 4.13a.75.75 0 0 1 0 1.06a.74.74 0 0 1-.53.22Z"/>
                </svg>
                <input id="mobile-search-input" type="text"
                       class="flex-1 outline-none text-primary bg-transparent border-none placeholder:italic"
                       placeholder="<%= searchbarJson.search %>"
                       autocomplete="off">
                <button id="clear-mobile-search-input-btn" class="hidden">
                    <svg class="w-5 h-5"
                         aria-hidden="true"
                         xmlns="http://www.w3.org/2000/svg"
                         width="24"
                         height="24"
                         fill="none"
                         viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M6 18 17.94 6M18 18 6.06 6"/>
                    </svg>
                </button>
            </div>

            <button id="close-mobile-search-bar" class="rounded text-xl p-1.5 primary-border transition">
                <svg class="w-7 h-7"
                     aria-hidden="true"
                     xmlns="http://www.w3.org/2000/svg"
                     width="24"
                     height="24"
                     fill="none"
                     viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M6 18 17.94 6M18 18 6.06 6"/>
                </svg>
            </button>
        </div>

        <div id="mobile-search-dropdown"
             class="absolute top-full left-0 right-0 p-3 background-color-alt shadow-lg z-[100] hidden max-h-[70vh] overflow-y-auto">

            <%- include('app-shimmer', { shimmerId: 'mobile-search-shimmer' }) %>

            <ul id="mobile-search-results"></ul>

            <div id="mobile-search-empty" class="text-sm text-gray-500 hidden"></div>
        </div>
    </div>
</header>