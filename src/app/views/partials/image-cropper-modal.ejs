<div class="crop-modal hidden fixed inset-0 bg-black/60 items-center justify-center z-[500]">
    <div class="background-color-alt p-6 rounded shadow max-w-[90vw]">
        <div class="w-full sm:w-[400px]">
            <img class="crop-image max-w-full max-h-[80vh] object-contain" src="" alt="Crop preview">
        </div>
        <div class="mt-3 flex gap-2 justify-end">
            <button class="crop-cancel px-3 py-1 primary-border text-primary rounded"><%= cancelLabel %></button>
            <button class="crop-save px-3 py-1 button-primary rounded"><%= saveLabel %></button>
        </div>
    </div>
</div>
